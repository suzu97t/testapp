{
  "name": "dandori",
  "version": "0.1.0",
  "description": "ローカルで使う、プロジェクトマネジメントと要件定義のサポートツール",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "bin": { "dandori": "bin/dandori.js" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/dandori.js serve --open",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e.mjs && node --disable-warning=ExperimentalWarning test/e2e-req.mjs"
  }
}
